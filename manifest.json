{
  "manifest_version": 3,
  "name": "Padikkan Bumper — പഠിക്കാൻ ബംപർ",
  "version": "1.0.0",
  "description": "പഠിക്കണോ മോനേ? റീൽസ് കണ്ട് കോയിൻ നേടി, ടിക്കറ്റ് എടുത്ത്, ഭാഗ്യമുണ്ടെങ്കിൽ പഠിക്കാം.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "പഠിക്കാൻ ബംപർ",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "src/background/service-worker.js"
  },

  "permissions": ["storage", "alarms", "tabs", "notifications"],
  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": [
        "src/shared/config.js",
        "src/shared/fx.js",
        "src/shared/overlay-ui.js",
        "src/content/blocker.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/shared/config.js",
        "src/shared/fx.js",
        "src/content/earner.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/content/overlay.css", "icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ],

  "minimum_chrome_version": "102"
}
